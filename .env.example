# ─────────────────────────────────────────────────────────────────────
# Copy to `.env.local` and fill in. Everything here is optional: the site
# runs without any of it, falling back to the values in `data/`.
#
# NEXT_PUBLIC_* values are inlined into the client bundle — never put a
# secret behind that prefix.
# ─────────────────────────────────────────────────────────────────────

# ── Identity (public) ────────────────────────────────────────────────
NEXT_PUBLIC_NAME="Faizan Alam"
NEXT_PUBLIC_EMAIL="faizansaikh786786f@gmail.com"
NEXT_PUBLIC_PHONE="+91 98356 31769"
NEXT_PUBLIC_SITE_URL="https://www.faizanalam.pro"
NEXT_PUBLIC_GITHUB_URL="https://github.com/faizanalam9835"
NEXT_PUBLIC_GITHUB_USERNAME="faizanalam9835"
NEXT_PUBLIC_LINKEDIN_URL="https://www.linkedin.com/in/faizan-alam-091063334/"
NEXT_PUBLIC_RESUME_URL="/resume.pdf"

# ── Profile photo ────────────────────────────────────────────────────
# Full-page background portrait. Leave unset to use `public/hero.png`.
NEXT_PUBLIC_AVATAR_URL="/hero.png"

# ── Contact delivery (server only) ───────────────────────────────────
# Option A — EmailJS (dashboard.emailjs.com). Also turn on
# Account → Security → "Allow EmailJS API for non-browser applications".
EMAILJS_SERVICE_ID=""
EMAILJS_TEMPLATE_ID=""
EMAILJS_PUBLIC_KEY=""
EMAILJS_PRIVATE_KEY=""

# Option B — email via Resend
RESEND_API_KEY=""
CONTACT_TO_EMAIL=""
CONTACT_FROM_EMAIL="Portfolio <onboarding@resend.dev>"

# Option C — POST to a webhook (Slack, Discord, n8n, Zapier…)
CONTACT_WEBHOOK_URL=""
